###############################################
# 🌈 NEONJULIA — EDITORCONFIG NEONIDE v2.7   #
###############################################

root = true

# ╔══════════════════════════════════════════╗
# ║        🧩 PARAMÈTRES GLOBAUX             ║
# ╚══════════════════════════════════════════╝
[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# ╔══════════════════════════════════════════╗
# ║        🧬 JULIA                          ║
# ╚══════════════════════════════════════════╝
[*.jl]
indent_size = 4
max_line_length = 120

# ╔══════════════════════════════════════════╗
# ║        📘 MARKDOWN                       ║
# ╚══════════════════════════════════════════╝
[*.md]
indent_size = 2
trim_trailing_whitespace = false

###############################################
# 🛰️ SCHÉMA VISUEL
#
#   ┌───────────────┐
#   │ 4 spaces       │ ← Julia
#   ├───────────────┤
#   │ 2 spaces       │ ← Markdown
#   └───────────────┘
#
#   UTF‑8 / LF / Clean EOF
###############################################
